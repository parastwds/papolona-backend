{
  "info": {
    "name": "Papolona API – Phase 1 (Onboarding & Account)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order: Questionnaire submit → Register (tokens are saved automatically)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "email",
      "value": "asha@example.com"
    },
    {
      "key": "password",
      "value": "Papolona123"
    },
    {
      "key": "submissionId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. App & content",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "App config (Splash)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/app/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "app",
                "config"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Questionnaire",
      "item": [
        {
          "name": "Get questionnaire",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/onboarding/questionnaire",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "onboarding",
                "questionnaire"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Submit answers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data; if (d) pm.collectionVariables.set('submissionId', d.submissionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/onboarding/questionnaire/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "onboarding",
                "questionnaire",
                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": 1,\n  \"answers\": [\n    {\n      \"questionKey\": \"q1\",\n      \"optionKey\": \"q1b\"\n    },\n    {\n      \"questionKey\": \"q2\",\n      \"optionKey\": \"q2b\"\n    },\n    {\n      \"questionKey\": \"q3\",\n      \"optionKey\": \"q3b\"\n    },\n    {\n      \"questionKey\": \"q4\",\n      \"optionKey\": \"q4b\"\n    },\n    {\n      \"questionKey\": \"q5\",\n      \"optionKey\": \"q5b\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "3. Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data || {};",
                  "const t = d.tokens; if (t) { pm.collectionVariables.set('accessToken', t.accessToken); pm.collectionVariables.set('refreshToken', t.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Verma\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"+919876543210\",\n  \"questionnaireSubmissionId\": \"{{submissionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data || {};",
                  "const t = d.tokens; if (t) { pm.collectionVariables.set('accessToken', t.accessToken); pm.collectionVariables.set('refreshToken', t.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data || {};",
                  "const t = d.tokens; if (t) { pm.collectionVariables.set('accessToken', t.accessToken); pm.collectionVariables.set('refreshToken', t.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Logout (this device)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Logout all devices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout-all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout-all"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Verify reset code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-reset-code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-reset-code"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewPassword9\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "4. Profile & settings",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update profile (name, bio...)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha V.\",\n  \"bio\": \"Painter and curious mind\",\n  \"country\": \"IN\",\n  \"timezone\": \"Asia/Kolkata\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Changes apply immediately. Email, phone and password have their own two-step requests (code by email)."
          }
        },
        {
          "name": "Change email - 1. send code",
          "request": {
            "method": "POST",
            "description": "Sends a 6-digit code to the NEW email. Nothing changes until step 2.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha.new@example.com\",\n  \"currentPassword\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Change email - 2. confirm code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('email', pm.response.json().data.user.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Use the 6-digit code from the email (printed in the server console when SMTP is not configured). On success the new email is saved to {{email}} for Login.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/email/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "email",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Change phone - 1. send code",
          "request": {
            "method": "POST",
            "description": "Sends a 6-digit code to the account email. Send \"phone\": null to remove the number. Nothing changes until step 2.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/phone",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "phone"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Change phone - 2. confirm code",
          "request": {
            "method": "POST",
            "description": "Use the 6-digit code from the email (printed in the server console when SMTP is not configured).",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/phone/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "phone",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Upload profile photo",
          "request": {
            "method": "PUT",
            "description": "Body > form-data: key `avatar` (type File). Click the value cell and pick a JPG, PNG or WebP up to 5 MB. Do not set Content-Type yourself; Postman adds the multipart boundary. Uploading again replaces the photo.",
            "header": [
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/avatar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "avatar"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Remove profile photo",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/avatar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "avatar"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "settings"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-platform",
                "value": "android"
              },
              {
                "key": "x-app-version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "settings"
              ]
            },
            "body": {
              "mode": "raw",
